// ============================================================
// Bridge Practice Server (Zeqa-style) — "time" mode + "clutch" mode
// ============================================================
// Assumptions (validate/adjust if your item/block catalog differs):
//   blocks: "stone", "sandstone"
//   items:  "light_blue_wool" (Clutch selector), "yellow_wool" (Time selector),
//           "green_dye", "red_dye", "compass", "sandstone", "diamond_pickaxe"
//   enchant id: "efficiency"
// scriptLoad logs a warning if any of these don't exist on this planet.
//
// NOTE: the text markup only documents color/bold/italic/underline/glow/reset —
// there's no dedicated "bigger text" tag, so "少しでかく" is approximated with \bold\.
// NOTE: game.scoreboard.set() is a single server-wide sidebar (no per-viewer API
// documented), so "Personal Best" / "Time" reflect whichever time-mode player most
// recently finished a run — it can't truly be a different view per player.

// ---------------- CONFIG ----------------

const LOBBY_POS = { x: 0, y: 65, z: 0 };

const CLUTCH_BASE_X = 0, CLUTCH_BASE_Z = 2000, CLUTCH_Y = 100;
const CLUTCH_SPACING = 40;
const CLUTCH_COLS = 6;
const CLUTCH_SLOTS = 24;

const TIME_BASE_X = 0, TIME_BASE_Z = -2000, TIME_Y = 100;
const TIME_SPACING = 50;       // spacing between pair columns
const TIME_GAP = 30;           // distance from island A to island B (along -Z)
const TIME_ROW_SPACING = TIME_GAP + 40; // spacing between pair rows, keeps bridges clear of each other
const TIME_COLS = 4;
const TIME_PAIRS = 16;

const VOID_MARGIN = 15;    // blocks below island Y that trigger a safety teleport
const ISLAND_RADIUS = 3.5; // "on island" detection radius

// Knockback is always along the Z axis (never based on player look direction),
// and always toward POSITIVE Z.
const CLUTCH_KB_Z_DIRECTION = 1;

// Approximate gravity (blocks/tick^2) used to convert a desired peak height in
// BLOCKS into an initial vertical launch velocity, so the "up knockback" setting
// is calibrated in something a player can reason about instead of a raw velocity
// number that swings wildly with tiny changes.
const CLUTCH_GRAVITY = 0.08;
function heightToVelocity(blocks) {
  return Math.sqrt(2 * CLUTCH_GRAVITY * blocks);
}

const DEFAULT_CLUTCH_SETTINGS = {
  backKnockback: 1.2,
  upKnockback: 5, // blocks of peak height, not a raw velocity
  delayTicks: 20,
  comboCount: 3,
  cooldownTicks: 40,
};

// Timer must be crossed moving in the -Z direction; the finish line sits a fixed
// offset before the spawn point (matches TIME_BASE_Z - 20 = -2020, TIME_Y - 5 = 95
// for the first island pair) and generalizes the same way for every other pair.
const TIME_FINISH_Z_OFFSET = 20;
const TIME_FINISH_MIN_Y = TIME_Y - 5;

// ---------------- RUNTIME STATE (in-memory, per script instance) ----------------

let clutchOccupancy = {}; // slotIndex -> uuid
let timeOccupancy = {};   // pairIndex -> uuid
let buildQueue = [];

// ---------------- LAYOUT HELPERS ----------------

function clutchIslandPos(i) {
  const col = i % CLUTCH_COLS;
  const row = Math.floor(i / CLUTCH_COLS);
  return { x: CLUTCH_BASE_X + col * CLUTCH_SPACING, y: CLUTCH_Y, z: CLUTCH_BASE_Z + row * CLUTCH_SPACING };
}

function timeIslandPair(i) {
  const col = i % TIME_COLS;
  const row = Math.floor(i / TIME_COLS);
  const baseX = TIME_BASE_X + col * TIME_SPACING;
  const baseZ = TIME_BASE_Z - row * TIME_ROW_SPACING;
  return {
    a: { x: baseX, y: TIME_Y, z: baseZ },
    b: { x: baseX, y: TIME_Y, z: baseZ - TIME_GAP },
  };
}

// ---------------- BUILDING ----------------

function buildLobby() {
  game.world.fill(LOBBY_POS.x - 5, LOBBY_POS.y - 1, LOBBY_POS.z - 5, LOBBY_POS.x + 5, LOBBY_POS.y - 1, LOBBY_POS.z + 5, "stone");
}

function buildClutchIsland(i) {
  const pos = clutchIslandPos(i);
  game.world.fill(pos.x - 2, pos.y, pos.z - 2, pos.x + 2, pos.y, pos.z + 2, "stone");
}

function buildTimeIslandPair(i) {
  const pair = timeIslandPair(i);
  game.world.fill(pair.a.x - 2, pair.a.y, pair.a.z - 2, pair.a.x + 2, pair.a.y, pair.a.z + 2, "sandstone");
  game.world.fill(pair.b.x - 2, pair.b.y, pair.b.z - 2, pair.b.x + 2, pair.b.y, pair.b.z + 2, "sandstone");
}

function queueAllBuilds() {
  for (let i = 0; i < CLUTCH_SLOTS; i++) buildQueue.push({ type: "clutch", index: i });
  for (let i = 0; i < TIME_PAIRS; i++) buildQueue.push({ type: "time", index: i });
}

function processBuildQueue() {
  for (let n = 0; n < 2 && buildQueue.length > 0; n++) {
    const job = buildQueue.shift();
    if (job.type === "clutch") buildClutchIsland(job.index);
    else buildTimeIslandPair(job.index);
  }
  if (buildQueue.length === 0) {
    game.storage.set("arenasBuilt", true);
  }
}

// ---------------- SLOT ASSIGNMENT ----------------

function assignClutchSlot(p) {
  for (let i = 0; i < CLUTCH_SLOTS; i++) {
    if (!clutchOccupancy[i]) {
      clutchOccupancy[i] = p.uuid;
      return i;
    }
  }
  return null;
}

function assignTimeSlot(p) {
  for (let i = 0; i < TIME_PAIRS; i++) {
    if (!timeOccupancy[i]) {
      timeOccupancy[i] = p.uuid;
      return i;
    }
  }
  return null;
}

function freeSlot(p, d) {
  d = d || {};
  if (d.mode === "clutch" && d.clutchSlot !== undefined) {
    if (clutchOccupancy[d.clutchSlot] === p.uuid) delete clutchOccupancy[d.clutchSlot];
  } else if (d.mode === "time" && d.timePair !== undefined) {
    if (timeOccupancy[d.timePair] === p.uuid) delete timeOccupancy[d.timePair];
  }
}

// ---------------- LOBBY ITEMS ----------------

function giveLobbyItems(p) {
  p.give("light_blue_wool", 1, { name: "\\cyan\\clutch" });
  p.give("yellow_wool", 1, { name: "\\yellow\\Time" });
}

// ---------------- MODE TRANSITIONS ----------------

function returnToLobby(p) {
  freeSlot(p, p.getData());
  p.setData({ mode: "lobby" });
  p.setGameMode("survival");
  game.runCommand("clear " + p.name);
  giveLobbyItems(p);
  p.teleport(LOBBY_POS.x + 0.5, LOBBY_POS.y + 1, LOBBY_POS.z + 0.5);
  p.sendMessage("\\gray\\Returned to lobby.");
}

function enterClutchMode(p) {
  freeSlot(p, p.getData());
  const slot = assignClutchSlot(p);
  if (slot === null) {
    p.sendMessage("\\red\\All clutch islands are full right now, try again soon.");
    return;
  }
  const pos = clutchIslandPos(slot);
  p.setData({ mode: "clutch", clutchSlot: slot, clutchRunning: false });
  p.setGameMode("survival");
  game.runCommand("clear " + p.name);
  p.give("green_dye", 1, { name: "\\green\\Start Clutch" });
  p.give("compass", 1, { name: "\\aqua\\Clutch Settings" });
  p.give("red_dye", 1, { name: "\\red\\Return to Lobby" });
  p.teleport(pos.x + 0.5, pos.y + 1, pos.z + 0.5);
  p.sendMessage("\\aqua\\Welcome to Clutch mode! Right-click the green dye to start a run.");
}

function enterTimeMode(p) {
  freeSlot(p, p.getData());
  const pairIndex = assignTimeSlot(p);
  if (pairIndex === null) {
    p.sendMessage("\\red\\All time islands are full right now, try again soon.");
    return;
  }
  const pair = timeIslandPair(pairIndex);
  p.setData({ mode: "time", timePair: pairIndex, timerRunning: false, timerStart: null });
  p.setGameMode("survival");
  game.runCommand("clear " + p.name);
  // Slots 1 & 2: two 64-stacks of sandstone = 128 total.
  p.give("sandstone", 64);
  p.give("sandstone", 64);
  p.give("diamond_pickaxe", 1, { enchants: [{ id: "efficiency", level: 30 }] });
  p.give("red_dye", 1, { name: "\\red\\Return to Lobby" });
  p.teleport(pair.a.x + 0.5, pair.a.y + 1, pair.a.z + 0.5);
  p.sendMessage("\\aqua\\Bridge in the -Z direction to the other island! Leave spawn to start the timer.");
}

// ---------------- CLUTCH PRACTICE ----------------

function startClutchPractice(p) {
  const d = p.getData() || {};
  if (d.mode !== "clutch") return;
  if (d.clutchRunning) {
    p.sendMessage("\\red\\A clutch run is already in progress!");
    return;
  }
  const settings = game.playerData.get(p.uuid, "clutchSettings", DEFAULT_CLUTCH_SETTINGS);
  d.clutchRunning = true;
  d.clutchHitsLeft = settings.comboCount;
  p.setData(d);
  p.sendMessage("\\yellow\\Clutch practice starting...");
  scheduleClutchHit(p.name, settings);
}

function scheduleClutchHit(playerName, settings) {
  game.after(game.util.ticksToSeconds(settings.delayTicks), () => {
    const cur = game.getPlayer(playerName);
    if (!cur) return;
    const d = cur.getData() || {};
    if (!d.clutchRunning) return;

    // Always +Z, never based on where the player is looking.
    cur.launch(0, heightToVelocity(settings.upKnockback), CLUTCH_KB_Z_DIRECTION * settings.backKnockback);

    d.clutchHitsLeft = (d.clutchHitsLeft || 1) - 1;
    cur.setData(d);

    if (d.clutchHitsLeft > 0) {
      game.after(game.util.ticksToSeconds(settings.cooldownTicks), () => scheduleClutchHit(playerName, settings));
    } else {
      const finalD = cur.getData() || {};
      finalD.clutchRunning = false;
      cur.setData(finalD);
      cur.sendMessage("\\green\\Clutch practice complete! Right-click the green dye to go again.");
    }
  });
}

// ---------------- CLUTCH SETTINGS GUI ----------------

function round1(n) { return Math.round(n * 10) / 10; }

function valueItem(icon, label, value) {
  return { item: icon, name: "\\gold\\" + label, lore: [String(value)], enabled: false };
}

function openClutchSettingsGui(p) {
  const stored = game.playerData.get(p.uuid, "clutchSettings", null) || DEFAULT_CLUTCH_SETTINGS;
  const draft = Object.assign({}, DEFAULT_CLUTCH_SETTINGS, stored);
  let menu;

  function refresh() {
    menu.setItem(4, valueItem("feather", "Back Knockback", draft.backKnockback.toFixed(1)));
    menu.setItem(13, valueItem("feather", "Up Knockback", draft.upKnockback + " blocks"));
    menu.setItem(22, valueItem("clock", "Hit Delay", draft.delayTicks + " ticks"));
    menu.setItem(31, valueItem("gunpowder", "Hit Count", String(draft.comboCount)));
    menu.setItem(40, valueItem("clock", "Cooldown", draft.cooldownTicks + " ticks"));
  }

  function adjust(field, delta, min, max, round) {
    return () => {
      const raw = draft[field] + delta;
      draft[field] = game.util.clamp(round ? round1(raw) : Math.round(raw), min, max);
      refresh();
    };
  }

  const items = [
    { slot: 1, item: "redstone", name: "\\red\\-0.1", onClick: adjust("backKnockback", -0.1, 0.1, 3.0, true) },
    { slot: 4, item: "feather", name: "\\gold\\Back Knockback", lore: [draft.backKnockback.toFixed(1)], enabled: false },
    { slot: 7, item: "emerald", name: "\\green\\+0.1", onClick: adjust("backKnockback", 0.1, 0.1, 3.0, true) },

    { slot: 10, item: "redstone", name: "\\red\\-1 block", onClick: adjust("upKnockback", -1, 1, 15, false) },
    { slot: 13, item: "feather", name: "\\gold\\Up Knockback", lore: [draft.upKnockback + " blocks"], enabled: false },
    { slot: 16, item: "emerald", name: "\\green\\+1 block", onClick: adjust("upKnockback", 1, 1, 15, false) },

    { slot: 19, item: "redstone", name: "\\red\\-5 ticks", onClick: adjust("delayTicks", -5, 0, 100, false) },
    { slot: 22, item: "clock", name: "\\gold\\Hit Delay", lore: [draft.delayTicks + " ticks"], enabled: false },
    { slot: 25, item: "emerald", name: "\\green\\+5 ticks", onClick: adjust("delayTicks", 5, 0, 100, false) },

    { slot: 28, item: "redstone", name: "\\red\\-1", onClick: adjust("comboCount", -1, 1, 10, false) },
    { slot: 31, item: "gunpowder", name: "\\gold\\Hit Count", lore: [String(draft.comboCount)], enabled: false },
    { slot: 34, item: "emerald", name: "\\green\\+1", onClick: adjust("comboCount", 1, 1, 10, false) },

    { slot: 37, item: "redstone", name: "\\red\\-5 ticks", onClick: adjust("cooldownTicks", -5, 5, 200, false) },
    { slot: 40, item: "clock", name: "\\gold\\Cooldown", lore: [draft.cooldownTicks + " ticks"], enabled: false },
    { slot: 43, item: "emerald", name: "\\green\\+5 ticks", onClick: adjust("cooldownTicks", 5, 5, 200, false) },

    { slot: 47, item: "barrier", name: "\\red\\Cancel", onClick: (ctx) => {
        ctx.player.sendMessage("\\gray\\Cancelled.");
        menu.close();
      } },
    { slot: 51, item: "emerald_block", name: "\\green\\Confirm", onClick: (ctx) => {
        game.playerData.set(ctx.player.uuid, "clutchSettings", draft);
        ctx.player.sendMessage("\\green\\Clutch settings saved!");
        menu.close();
      } },
  ];

  menu = game.gui.open(p, { title: "\\aqua\\Clutch Settings", rows: 6, items: items });
}

// ---------------- TIME MODE FORMATTING + SCOREBOARD ----------------

function formatTimeComma(ms) {
  // Seconds to 3 decimal places, comma as the fractional separator per spec.
  return (ms / 1000).toFixed(3).replace(".", ",");
}

function blankLine(n) {
  // Distinct near-invisible spacer lines (avoids duplicate-string collisions).
  return "\\reset\\" + " ".repeat(n);
}

function buildTop3Lines() {
  const top3 = game.stats.top("besttime", 3, { order: "asc" }); // lower ms = faster = better
  const lines = [];
  for (let i = 0; i < 3; i++) {
    const entry = top3[i];
    if (entry) {
      lines.push("\\lime\\" + entry.name + "\\gray\\: \\yellow\\" + formatTimeComma(entry.value));
    } else {
      lines.push("\\lime\\---\\gray\\: \\yellow\\--,---");
    }
  }
  return lines;
}

function updateScoreboard(p) {
  const bestMs = game.playerData.get(p.uuid, "bestTimeMs", null);
  const lastMs = game.playerData.get(p.uuid, "lastTimeMs", null);

  const lines = [];
  lines.push("\\orange\\\\bold\\TOP3\\reset\\");
  lines.push(...buildTop3Lines());
  lines.push(blankLine(1));
  lines.push("\\cyan\\\\bold\\Personal Best\\reset\\");
  lines.push("\\yellow\\" + (bestMs !== null ? formatTimeComma(bestMs) : "--,---"));
  lines.push(blankLine(2));
  lines.push("\\lime\\\\bold\\Time\\reset\\");
  lines.push("\\yellow\\" + (lastMs !== null ? formatTimeComma(lastMs) : "--,---"));

  game.scoreboard.set("\\lime\\\\bold\\Fast Builder\\reset\\", lines);
}

// ---------------- INTERACTIONS ----------------

game.interactions.on("useItem", { item: "light_blue_wool" }, (ctx) => {
  ctx.cancel();
  if (ctx.initialPress === false) return;
  enterClutchMode(ctx.player);
});

game.interactions.on("useItem", { item: "yellow_wool" }, (ctx) => {
  ctx.cancel();
  if (ctx.initialPress === false) return;
  enterTimeMode(ctx.player);
});

game.interactions.on("useItem", { item: "green_dye" }, (ctx) => {
  ctx.cancel();
  if (ctx.initialPress === false) return;
  startClutchPractice(ctx.player);
});

game.interactions.on("useItem", { item: "compass" }, (ctx) => {
  ctx.cancel();
  if (ctx.initialPress === false) return;
  const d = ctx.player.getData() || {};
  if (d.mode === "clutch") openClutchSettingsGui(ctx.player);
});

game.interactions.on("useItem", { item: "red_dye" }, (ctx) => {
  ctx.cancel();
  if (ctx.initialPress === false) return;
  returnToLobby(ctx.player);
});

// ---------------- BLOCK BREAK RESTRICTION (all modes) ----------------

function resolveBreakPos(e) {
  if (e.pos) return e.pos;
  if (typeof e.x === "number") return { x: e.x, y: e.y, z: e.z };
  return null;
}

game.on("blockBreak", (e) => {
  let blockName = typeof e.block === "string" ? e.block : null;
  if (!blockName) {
    const pos = resolveBreakPos(e);
    if (pos) blockName = game.world.getBlock(pos.x, pos.y, pos.z);
  }
  if (blockName !== "sandstone") {
    e.cancel();
  }
});

// ---------------- VOID SAFETY + TIME-MODE TIMER ----------------

game.on("playerMove", (e) => {
  const p = e.player;
  const d = p.getData();
  if (!d || !d.mode) return;

  if (d.mode === "clutch") {
    const pos = clutchIslandPos(d.clutchSlot);
    if (p.pos.y < pos.y - VOID_MARGIN) {
      p.teleport(pos.x + 0.5, pos.y + 1, pos.z + 0.5);
      p.launch(0, 0.1, 0);
    }
    return;
  }

  if (d.mode === "time") {
    const pair = timeIslandPair(d.timePair);

    // Void safety: fell off the bridge.
    if (p.pos.y < pair.a.y - VOID_MARGIN) {
      p.teleport(pair.a.x + 0.5, pair.a.y + 1, pair.a.z + 0.5);
      p.launch(0, 0.1, 0);
      if (d.timerRunning) {
        d.timerRunning = false;
        d.timerStart = null;
        p.setData(d);
        p.sendMessage("\\red\\You fell! Timer reset.");
      }
      return;
    }

    if (!d.timerRunning) {
      // Only counts as "starting" when moving in the -Z direction.
      if (p.pos.z < pair.a.z - ISLAND_RADIUS) {
        d.timerRunning = true;
        d.timerStart = Date.now();
        p.setData(d);
        p.sendMessage("\\yellow\\Timer started!");
      }
      return;
    }

    const finishZ = pair.a.z - TIME_FINISH_Z_OFFSET;
    if (p.pos.z < finishZ && p.pos.y > TIME_FINISH_MIN_Y) {
      const elapsedMs = Date.now() - d.timerStart;

      d.timerRunning = false;
      d.timerStart = null;
      p.setData(d);

      const timeStr = formatTimeComma(elapsedMs);
      const titleMsg = "\\lime\\Time\\gray\\: \\yellow\\" + timeStr;
      game.runCommand('title ' + p.name + ' title "' + titleMsg + '"');

      game.playerData.set(p.uuid, "lastTimeMs", elapsedMs);
      const prevBest = game.playerData.get(p.uuid, "bestTimeMs", null);
      if (prevBest === null || elapsedMs < prevBest) {
        game.playerData.set(p.uuid, "bestTimeMs", elapsedMs);
        game.stats.set("besttime", p.uuid, elapsedMs, p.name);
      }

      updateScoreboard(p);

      // Reset the player back onto island A with fresh supplies.
      game.runCommand("clear " + p.name);
      p.give("sandstone", 64);
      p.give("sandstone", 64);
      p.give("diamond_pickaxe", 1, { enchants: [{ id: "efficiency", level: 30 }] });
      p.give("red_dye", 1, { name: "\\red\\Return to Lobby" });
      p.teleport(pair.a.x + 0.5, pair.a.y + 1, pair.a.z + 0.5);
    }
  }
});

// fallback: never let void/fall damage actually land while in an arena
game.on("entityDamage", (e) => {
  const target = e.player || (e.entity && e.entity.isPlayer ? e.entity : null);
  if (!target) return;
  const d = target.getData();
  if (d && (d.mode === "clutch" || d.mode === "time")) {
    e.cancel();
  }
});

// ---------------- JOIN / QUIT ----------------

game.on("playerJoin", (e) => {
  const p = e.player;
  p.setData({ mode: "lobby" });
  p.setGameMode("survival");
  giveLobbyItems(p);
  p.teleport(LOBBY_POS.x + 0.5, LOBBY_POS.y + 1, LOBBY_POS.z + 0.5);
  p.sendMessage("\\gold\\Welcome to the Bridge Practice server!");
  p.sendMessage("\\cyan\\Right-click clutch\\gray\\ / \\yellow\\Time\\gray\\ in your hotbar to pick a mode.");
});

game.on("playerQuit", (e) => {
  freeSlot(e.player, e.player.getData());
});

// ---------------- SETUP ----------------

game.on("scriptLoad", () => {
  const blockNamesToCheck = ["stone", "sandstone"];
  for (let i = 0; i < blockNamesToCheck.length; i++) {
    if (!game.blocks.exists(blockNamesToCheck[i])) {
      console.log("WARNING: block '" + blockNamesToCheck[i] + "' not found on this planet — adjust the script.");
    }
  }
  const itemsToCheck = ["light_blue_wool", "yellow_wool", "green_dye", "red_dye", "compass", "sandstone", "diamond_pickaxe"];
  for (let i = 0; i < itemsToCheck.length; i++) {
    if (!game.items.exists(itemsToCheck[i])) {
      console.log("WARNING: item '" + itemsToCheck[i] + "' not found on this planet — adjust the script.");
    }
  }

  buildLobby();

  if (!game.storage.get("arenasBuilt", false)) {
    queueAllBuilds();
  }
  game.every(0.1, processBuildQueue);
});
