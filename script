// ======================================================================
// クロスボウ (Crossbow) スクリプト
// ・普通の状態(cbow:crossbow)を右クリック長押しすると装填アニメーションが始まる
//   0.5秒ごとに pulling_0 → pulling_1 → pulling_2 と見た目が変わり、
//   1.5秒経過すると装填完了(cbow:crossbow_loaded)になる
// ・装填完了した瞬間に矢を1本消費する（クリエイティブは消費しない）
// ・矢がない状態(サバイバル/アドベンチャー)では装填完了できず、普通の状態に戻る
// ・途中で右クリックをやめるとキャンセル(普通の状態に戻る、矢は消費されない)
// ・矢セット状態でもう一度右クリックすると、視線方向に矢を発射
// ・発射後は0.5秒のクールダウン(連打で矢が連発しないように)
// ・地面に刺さった矢に近づくと自動で拾える(アイテムとして手に入る)
// ======================================================================

const CHARGE_TIME_MS = 1500;      // 装填完了までの時間
const PULL1_TIME_MS = 500;        // pulling_1に切り替わるタイミング
const PULL2_TIME_MS = 1000;       // pulling_2に切り替わるタイミング
const FIRE_COOLDOWN_MS = 500;     // 発射後のクールダウン
const RELEASE_TIMEOUT_MS = 350;   // これだけ合図が来なかったら「離した」と判定
const CHECK_INTERVAL_SEC = 0.1;   // 装填チェックの間隔(秒)
const ARROW_SPEED = 3.0;          // 矢の初速
const EYE_HEIGHT = 1.6;           // 目線の高さ

const PICKUP_RADIUS = 1.0;        // 矢を拾える距離
const PICKUP_SCAN_SEC = 0.25;     // 矢の着地/回収チェック間隔
const ARROW_TRACK_TIMEOUT_MS = 60000; // これ以上経ったら追跡をやめる(ワールドのゴミにしない)

// アイテムID (namespace:item 形式)
const ITEM_STANDBY = "cbow:crossbow";
const ITEM_PULL0 = "cbow:crossbow_pulling_0";
const ITEM_PULL1 = "cbow:crossbow_pulling_1";
const ITEM_PULL2 = "cbow:crossbow_pulling_2";
const ITEM_LOADED = "cbow:crossbow_loaded";

// スプライトキー (namespace:key 形式)
const SPRITE_STANDBY = "cbow:crossbow_standby";
const SPRITE_PULL0 = "cbow:crossbow_pulling_0";
const SPRITE_PULL1 = "cbow:crossbow_pulling_1";
const SPRITE_PULL2 = "cbow:crossbow_pulling_2";
const SPRITE_ARROW = "cbow:crossbow_arrow";

// data URL化した画像(すべてRGBA変換済み)
const TEX_STANDBY = "data:image/png;base64,";
const TEX_ARROW = "data:image/png;base64,";
const TEX_PULL0 = "data:image/png;base64,";
const TEX_PULL1 = "data:image/png;base64,";
const TEX_PULL2 = "data:image/png;base64,";

// ---- アイテム登録 ----
game.mods.register({
  sprites: {
    [SPRITE_STANDBY]: TEX_STANDBY,
    [SPRITE_PULL0]: TEX_PULL0,
    [SPRITE_PULL1]: TEX_PULL1,
    [SPRITE_PULL2]: TEX_PULL2,
    [SPRITE_ARROW]: TEX_ARROW,
  },
  items: [
    { name: ITEM_STANDBY, displayName: "Crossbow", template: "generic", layers: [{ texture: SPRITE_STANDBY, tint: 16777215 }] },
    { name: ITEM_PULL0, displayName: "Crossbow", template: "generic", layers: [{ texture: SPRITE_PULL0, tint: 16777215 }] },
    { name: ITEM_PULL1, displayName: "Crossbow", template: "generic", layers: [{ texture: SPRITE_PULL1, tint: 16777215 }] },
    { name: ITEM_PULL2, displayName: "Crossbow", template: "generic", layers: [{ texture: SPRITE_PULL2, tint: 16777215 }] },
    { name: ITEM_LOADED, displayName: "Crossbow", template: "generic", layers: [{ texture: SPRITE_ARROW, tint: 16777215 }] },
  ],
});

// ---- プレイヤーごとの状態ヘルパー ----
function getState(p) {
  return p.getData() || {};
}
function setState(p, state) {
  p.setData(state);
}

// ---- 装填チェックのループ（自分自身をスケジュールし続ける） ----
function scheduleChargeCheck(playerName, chargeStartTime) {
  game.after(CHECK_INTERVAL_SEC, () => {
    const p = game.getPlayer(playerName);
    if (!p) return;

    const state = getState(p);
    if (!state.charging) return;

    const held = p.getHeldItem();
    const currentItem = held ? held.item : null;
    // 装填中に持てるはずのアイテム以外に変わっていたら、離した/キャンセル扱い
    const chargingItems = [ITEM_STANDBY, ITEM_PULL0, ITEM_PULL1, ITEM_PULL2];
    if (!currentItem || chargingItems.indexOf(currentItem) === -1) {
      state.charging = false;
      setState(p, state);
      return;
    }

    const now = Date.now();
    const lastSeen = state.lastSeen || chargeStartTime;

    // 一定時間、合図(useItem)が来ていなければ「離した」と判断してキャンセル
    if (now - lastSeen > RELEASE_TIMEOUT_MS) {
      state.charging = false;
      if (currentItem !== ITEM_STANDBY) p.setHeldItem(ITEM_STANDBY, 1);
      setState(p, state);
      return;
    }

    const elapsed = now - chargeStartTime;

    // 経過時間に応じて見た目を切り替える
    if (elapsed >= CHARGE_TIME_MS) {
      // 装填完了！矢があるかチェック
      const isCreative = p.isCreative();
      const hasArrow = isCreative || p.countItem("arrow") >= 1;

      if (hasArrow) {
        if (!isCreative) p.removeItem("arrow", 1); // ここで矢を消費
        p.setHeldItem(ITEM_LOADED, 1);
        state.loaded = true;
      } else {
        // 矢切れ：装填できないので普通の状態に戻す
        p.setHeldItem(ITEM_STANDBY, 1);
        p.sendMessage("\\red\\矢がありません！");
      }
      state.charging = false;
      setState(p, state);
      return;
    } else if (elapsed >= PULL2_TIME_MS) {
      if (currentItem !== ITEM_PULL2) p.setHeldItem(ITEM_PULL2, 1);
    } else if (elapsed >= PULL1_TIME_MS) {
      if (currentItem !== ITEM_PULL1) p.setHeldItem(ITEM_PULL1, 1);
    }
    // (0〜PULL1_TIME_MSの間はPULL0のまま。PULL0への切り替えは開始時に即座に行う)

    // 次のチェックを予約して続行
    scheduleChargeCheck(playerName, chargeStartTime);
  });
}

// ---- 装填中のアイテムを右クリック：装填開始 or 継続の合図 ----
function handleChargeUseItem(ctx) {
  if (ctx.button !== "right") return;
  ctx.cancel();

  const p = ctx.player;
  const state = getState(p);
  const now = Date.now();

  if (!state.charging) {
    // まだ装填中じゃなければ、ここが装填スタート
    state.charging = true;
    state.loaded = false;
    state.chargeStart = now;
    state.lastSeen = now;
    setState(p, state);
    p.setHeldItem(ITEM_PULL0, 1); // 押した瞬間にすぐ見た目を変える
    scheduleChargeCheck(p.name, now);
  } else {
    // 押しっぱなしの間の合図 → 「まだ押してるよ」の印として時間を更新
    state.lastSeen = now;
    setState(p, state);
  }
}

game.interactions.on("useItem", { item: ITEM_STANDBY }, handleChargeUseItem);
game.interactions.on("useItem", { item: ITEM_PULL0 }, handleChargeUseItem);
game.interactions.on("useItem", { item: ITEM_PULL1 }, handleChargeUseItem);
game.interactions.on("useItem", { item: ITEM_PULL2 }, handleChargeUseItem);

// ---- トラッキング中の矢（着地判定・拾える判定用） ----
const trackedArrows = {};

// ---- 「crossbow_loaded」を右クリック：発射処理 ----
game.interactions.on("useItem", { item: ITEM_LOADED }, (ctx) => {
  if (ctx.button !== "right") return;
  if (!ctx.initialPress) return; // セミオート：新しく押した瞬間だけ反応
  ctx.cancel();

  const p = ctx.player;
  const state = getState(p);
  const now = Date.now();

  // クールダウン中は無視
  if (state.cooldownUntil && now < state.cooldownUntil) return;

  const look = p.getLook();
  const originX = p.pos.x;
  const originY = p.pos.y + EYE_HEIGHT;
  const originZ = p.pos.z;

  const arrowId = game.world.spawnEntity(
    originX, originY, originZ,
    "arrow",
    look.x * ARROW_SPEED,
    look.y * ARROW_SPEED,
    look.z * ARROW_SPEED,
    p
  );

  // 拾えるように追跡リストに登録
  if (arrowId) {
    trackedArrows[arrowId] = {
      lastPos: { x: originX, y: originY, z: originZ },
      landed: false,
      stillCount: 0,
      spawnTime: now,
    };
  }

  // 矢は装填時にもう消費済みなので、ここでは消費しない
  p.setHeldItem(ITEM_STANDBY, 1);

  state.charging = false;
  state.loaded = false;
  state.cooldownUntil = now + FIRE_COOLDOWN_MS;
  setState(p, state);
});

// ---- 矢の着地判定＆拾い上げ処理（定期的に実行） ----
game.every(PICKUP_SCAN_SEC, () => {
  for (const id in trackedArrows) {
    const rec = trackedArrows[id];

    // 追跡タイムアウト（ゴミにしないため）
    if (Date.now() - rec.spawnTime > ARROW_TRACK_TIMEOUT_MS) {
      delete trackedArrows[id];
      continue;
    }

    if (!game.entities.exists(id)) {
      delete trackedArrows[id];
      continue;
    }

    const pos = game.entities.getPos(id);
    if (!pos) {
      delete trackedArrows[id];
      continue;
    }

    if (!rec.landed) {
      // 前回チェック時とほぼ同じ位置なら「着地した」と判定
      const distSq = game.util.distanceSq(pos, rec.lastPos);
      if (distSq < 0.0009) {
        rec.stillCount++;
        if (rec.stillCount >= 2) rec.landed = true; // 2回連続で静止 = 着地確定
      } else {
        rec.stillCount = 0;
      }
      rec.lastPos = pos;
    }

    if (rec.landed) {
      const players = game.world.getPlayersNear(pos.x, pos.y, pos.z, PICKUP_RADIUS);
      if (players && players.length > 0) {
        players[0].give("arrow", 1);
        game.entities.remove(id);
        delete trackedArrows[id];
      }
    }
  }
});

// ---- テスト用コマンド：/getcrossbow でクロスボウを1本もらえる ----
game.commands.register("getcrossbow", { usage: "/getcrossbow" }, (sender) => {
  const p = sender.player || sender;
  if (p && p.give) {
    p.give(ITEM_STANDBY, 1);
    p.sendMessage("\\gold\\クロスボウを渡したよ！");
  }
});
